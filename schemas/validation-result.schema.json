{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-qa-agent.dev/schemas/validation-result.schema.json",
  "title": "Deterministic validation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "schema", "valid", "errors"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "artifact": { "type": "string", "minLength": 1 },
    "schema": { "type": "string", "minLength": 1 },
    "valid": { "type": "boolean" },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "code", "message"],
        "properties": {
          "path": { "type": "string" },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "valid": { "const": true } } },
      "then": { "properties": { "errors": { "maxItems": 0 } } },
      "else": { "properties": { "errors": { "minItems": 1 } } }
    }
  ]
}
